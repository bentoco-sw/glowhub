# Normalize line endings across macOS and Linux CI runners
* text=auto eol=lf

# Force binary handling for assets and spreadsheets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.xlsx binary
*.zip binary

# Keep shell scripts LF and batch/command executable metadata clean
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.gs text eol=lf
